generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["master", "transaction"]
}

model User {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_seq          BigInt           @default(autoincrement())
  name            String
  email           String           @unique
  password_hash   String?          @map("password_hash")
  role            String           @default("customer")
  created_at      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updated_at      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  identities      UserIdentity[]
  sessions        Session[]
  role_rel        Role?            @relation(fields: [role], references: [id])
  created_invites ResellerInvite[] @relation("InviteCreator")
  claimed_invites ResellerInvite[] @relation("InviteClaimer")
  motorbikes      CustomerMotorbike[]  @relation("UserMotorbikes")
  orders          Order[]              @relation("UserOrders")
  certificates    ExhaustCertificate[] @relation("UserCertificates")
  created_motorbikes CustomerMotorbike[] @relation("MotorbikeCreator")
  updated_motorbikes CustomerMotorbike[] @relation("MotorbikeUpdater")
  deleted_motorbikes CustomerMotorbike[] @relation("MotorbikeDeleter")
  created_orders  Order[]              @relation("OrderCreator")
  updated_orders  Order[]              @relation("OrderUpdater")
  created_certificates ExhaustCertificate[] @relation("CertificateCreator")
  updated_certificates ExhaustCertificate[] @relation("CertificateUpdater")
  revoked_certificates ExhaustCertificate[] @relation("CertificateRevoker")

  @@map("t_mtr_users")
  @@schema("master")
}

model Role {
  id               String           @id @db.VarChar(30)
  name             String           @db.VarChar(50)
  description      String?          @db.Text
  can_access_admin Boolean          @default(false) @map("can_access_admin")
  can_access_b2b   Boolean          @default(false) @map("can_access_b2b")
  badge_style      Json             @default("{\"bg\": \"#1C180A\", \"border\": \"#B45309\", \"text\": \"#F59E0B\"}") @map("badge_style")
  created_at       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updated_at       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  users            User[]
  invites          ResellerInvite[]

  @@map("t_mtr_roles")
  @@schema("master")
}

model DiscountPolicy {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String    @unique @db.VarChar(50)
  name               String    @db.VarChar(100)
  description        String?   @db.Text
  discount_type      String    @default("PERCENTAGE") @map("discount_type") @db.VarChar(20)
  discount_value     Decimal   @map("discount_value") @db.Decimal(10, 2)
  target_roles       String[]  @map("target_roles")
  target_categories  String[]  @map("target_categories")
  target_product_ids String[]  @map("target_product_ids")
  min_order_qty      Int       @default(1) @map("min_order_qty")
  min_order_amount   Decimal   @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  coupon_code        String?   @map("coupon_code") @db.VarChar(50)
  criteria_rules     Json      @default("{}") @map("criteria_rules")
  priority           Int       @default(0)
  stacking_mode      String    @default("EXCLUSIVE") @map("stacking_mode") @db.VarChar(20)
  valid_from         DateTime? @map("valid_from") @db.Timestamptz
  valid_until        DateTime? @map("valid_until") @db.Timestamptz
  is_active          Boolean   @default(true) @map("is_active")
  created_at         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updated_at         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([target_roles])
  @@index([is_active, priority(sort: Desc)])
  @@map("t_mtr_discount_policies")
  @@schema("master")
}

model ResellerInvite {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token              String    @unique @db.VarChar(64)
  partner_name       String    @map("partner_name") @db.VarChar(120)
  partner_phone      String?   @map("partner_phone") @db.VarChar(30)
  role_to_grant      String    @default("reseller") @map("role_to_grant") @db.VarChar(30)
  created_by         String?   @map("created_by") @db.Uuid
  max_uses           Int       @default(1) @map("max_uses")
  used_count         Int       @default(0) @map("used_count")
  expires_at         DateTime  @map("expires_at") @db.Timestamptz
  claimed_at         DateTime? @map("claimed_at") @db.Timestamptz
  claimed_by_user_id String?   @map("claimed_by_user_id") @db.Uuid
  is_revoked         Boolean   @default(false) @map("is_revoked")
  created_at         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  role_grant Role  @relation(fields: [role_to_grant], references: [id])
  creator    User? @relation("InviteCreator", fields: [created_by], references: [id], onDelete: SetNull)
  claimed_by User? @relation("InviteClaimer", fields: [claimed_by_user_id], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([expires_at, is_revoked, used_count])
  @@map("t_trx_reseller_invites")
  @@schema("transaction")
}

model UserIdentity {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_seq           BigInt   @default(autoincrement())
  user_id          String   @map("user_id") @db.Uuid
  provider         String
  provider_user_id String   @map("provider_user_id")
  created_at       DateTime @default(now()) @map("created_at") @db.Timestamptz
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@index([user_id])
  @@map("t_mtr_user_identities")
  @@schema("master")
}

model AppConfig {
  key        String   @id
  value      String
  updated_at DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("t_mtr_app_config")
  @@schema("master")
}

model Session {
  token      String   @id
  user_id    String   @map("user_id") @db.Uuid
  expires_at DateTime @map("expires_at") @db.Timestamptz
  created_at DateTime @default(now()) @map("created_at") @db.Timestamptz
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("t_trx_sessions")
  @@schema("transaction")
}

model RegistrationOtp {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_seq        BigInt    @default(autoincrement())
  identifier    String
  otp_hash      String    @map("otp_hash")
  payload_enc   String?   @map("payload_enc")
  attempts      Int       @default(0)
  request_count Int       @default(1) @map("request_count")
  expires_at    DateTime  @map("expires_at") @db.Timestamptz
  locked_until  DateTime? @map("locked_until") @db.Timestamptz
  verified_at   DateTime? @map("verified_at") @db.Timestamptz
  created_at    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([identifier])
  @@map("t_trx_registration_otps")
  @@schema("transaction")
}

model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_seq      BigInt    @default(autoincrement())
  email       String    @db.VarChar(255)
  token_hash  String    @map("token_hash") @db.VarChar(128)
  expires_at  DateTime  @map("expires_at") @db.Timestamptz
  used_at     DateTime? @map("used_at") @db.Timestamptz
  ip_address  String?   @map("ip_address") @db.Inet
  created_at  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@index([token_hash])
  @@map("t_trx_password_resets")
  @@schema("transaction")
}

model RateLimit {
  ip_address      String    @map("ip_address") @db.Inet
  action          String
  window_start    DateTime  @default(now()) @map("window_start") @db.Timestamptz
  count           Int       @default(1)
  violation_count Int       @default(0) @map("violation_count")
  blocked_until   DateTime? @map("blocked_until") @db.Timestamptz

  @@id([ip_address, action])
  @@index([blocked_until])
  @@map("t_trx_rate_limits")
  @@schema("transaction")
}

model CampaignSlide {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    String   @db.VarChar(30)
  tag         String   @db.VarChar(50)
  title       String   @db.VarChar(150)
  strip_title String   @map("strip_title") @db.VarChar(80)
  href        String   @db.VarChar(255)
  image_url   String   @map("image_url") @db.VarChar(255)
  sort_order  Int      @default(0) @map("sort_order")
  is_active   Boolean  @default(true) @map("is_active")
  created_at  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updated_at  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([is_active, sort_order])
  @@map("t_mtr_campaign_slides")
  @@schema("master")
}

model CommunityEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    String   @db.VarChar(30)
  tag         String   @db.VarChar(50)
  event_date  String   @map("event_date") @db.VarChar(50)
  title       String   @db.VarChar(150)
  description String   @db.Text
  image_url   String   @map("image_url") @db.VarChar(255)
  href        String?  @db.VarChar(255)
  sort_order  Int      @default(0) @map("sort_order")
  is_active   Boolean  @default(true) @map("is_active")
  created_at  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updated_at  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([is_active, sort_order])
  @@map("t_mtr_community_events")
  @@schema("master")
}

model HomeValueProp {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  step_number String   @map("step_number") @db.VarChar(10)
  title       String   @db.VarChar(100)
  description String   @db.Text
  sort_order  Int      @default(0) @map("sort_order")
  is_active   Boolean  @default(true) @map("is_active")
  created_at  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updated_at  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([is_active, sort_order])
  @@map("t_mtr_home_value_props")
  @@schema("master")
}

model HomeNewArrival {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id     String   @map("product_id") @db.VarChar(50)
  badge_text     String?  @map("badge_text") @db.VarChar(50)
  name           String   @db.VarChar(100)
  category_label String   @map("category_label") @db.VarChar(50)
  inlet          String?  @db.VarChar(30)
  material       String?  @db.VarChar(50)
  price_display  String   @map("price_display") @db.VarChar(50)
  image_url      String   @map("image_url") @db.VarChar(255)
  href           String   @db.VarChar(255)
  sort_order     Int      @default(0) @map("sort_order")
  is_active      Boolean  @default(true) @map("is_active")
  created_at     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updated_at     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([is_active, sort_order])
  @@map("t_mtr_home_new_arrivals")
  @@schema("master")
}

// ==========================================
// 1. GARASI MOTOR PELANGGAN (Schema: master)
// ==========================================
model CustomerMotorbike {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String               @map("user_id") @db.Uuid
  brand           String               @db.VarChar(50)
  model           String               @db.VarChar(100)
  year            Int
  engine_specs    String               @map("engine_specs") @db.VarChar(100)
  header_port_mm  Int                  @default(50) @map("header_port_mm")
  is_primary      Boolean              @default(true) @map("is_primary")
  
  // Status Keaktifan & Soft Delete
  is_active       Boolean              @default(true) @map("is_active")
  deleted_at      DateTime?            @map("deleted_at") @db.Timestamptz
  deleted_by      String?              @map("deleted_by") @db.Uuid

  // Audit Trail
  created_at      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updated_at      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  created_by      String?              @map("created_by") @db.Uuid
  updated_by      String?              @map("updated_by") @db.Uuid

  user            User                 @relation("UserMotorbikes", fields: [user_id], references: [id], onDelete: Cascade)
  creator         User?                @relation("MotorbikeCreator", fields: [created_by], references: [id], onDelete: SetNull)
  updater         User?                @relation("MotorbikeUpdater", fields: [updated_by], references: [id], onDelete: SetNull)
  deleter         User?                @relation("MotorbikeDeleter", fields: [deleted_by], references: [id], onDelete: SetNull)
  certificates    ExhaustCertificate[]

  @@index([user_id, is_active])
  @@map("t_mtr_customer_motorbikes")
  @@schema("master")
}

// ==========================================
// 2. PESANAN & TAHAP FABRIKASI (Schema: transaction)
// ==========================================
model Order {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_code           String               @unique @map("order_code") @db.VarChar(30)
  user_id              String               @map("user_id") @db.Uuid
  product_name         String               @map("product_name") @db.VarChar(150)
  target_motorbike     String               @map("target_motorbike") @db.VarChar(100)
  
  // Status Pesanan & Keaktifan
  status               String               @default("IN_FABRICATION") @db.VarChar(30)
  is_active            Boolean              @default(true) @map("is_active")
  cancelled_at         DateTime?            @map("cancelled_at") @db.Timestamptz
  cancelled_reason     String?              @map("cancelled_reason") @db.Text

  // Tahap Fabrikasi
  fabrication_stage    String               @default("TIG_WELDING") @map("fabrication_stage") @db.VarChar(50)
  fabrication_progress Int                  @default(75) @map("fabrication_progress")
  courier_name         String?              @map("courier_name") @db.VarChar(50)
  waybill_number       String?              @map("waybill_number") @db.VarChar(50)
  estimated_delivery   DateTime?            @map("estimated_delivery") @db.Timestamptz

  // Audit Trail
  created_at           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updated_at           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  created_by           String?              @map("created_by") @db.Uuid
  updated_by           String?              @map("updated_by") @db.Uuid

  user                 User                 @relation("UserOrders", fields: [user_id], references: [id], onDelete: Cascade)
  creator              User?                @relation("OrderCreator", fields: [created_by], references: [id], onDelete: SetNull)
  updater              User?                @relation("OrderUpdater", fields: [updated_by], references: [id], onDelete: SetNull)
  certificate          ExhaustCertificate?

  @@index([user_id, is_active])
  @@map("t_trx_orders")
  @@schema("transaction")
}

// ==========================================
// 3. PASPOR KEASLIAN DIGITAL & QR (Schema: transaction)
// ==========================================
model ExhaustCertificate {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serial_number      String             @unique @map("serial_number") @db.VarChar(50)
  verification_token String             @default(dbgenerated("gen_random_uuid()")) @map("verification_token") @db.VarChar(64)
  order_id           String             @unique @map("order_id") @db.Uuid
  user_id            String             @map("user_id") @db.Uuid
  motorbike_id       String?            @map("motorbike_id") @db.Uuid
  model_name         String             @map("model_name") @db.VarChar(150)
  material_grade     String             @default("Grade 1 Japanese Titanium") @map("material_grade") @db.VarChar(100)
  welder_signature   String             @default("ARM Master Tech #04") @map("welder_signature") @db.VarChar(100)
  fabrication_date   DateTime           @default(now()) @map("fabrication_date") @db.Timestamptz
  
  // Status Garansi & Keaktifan
  warranty_type      String             @default("LIFETIME_STRUCTURAL_TIG_WELD") @map("warranty_type") @db.VarChar(50)
  warranty_status    String             @default("ACTIVE") @map("warranty_status") @db.VarChar(30)
  is_active          Boolean            @default(true) @map("is_active")
  
  // Status Pencabutan / Revokasi
  is_revoked         Boolean            @default(false) @map("is_revoked")
  revoked_reason     String?            @map("revoked_reason") @db.VarChar(255)
  revoked_at         DateTime?          @map("revoked_at") @db.Timestamptz
  revoked_by         String?            @map("revoked_by") @db.Uuid

  verification_count Int                @default(0) @map("verification_count")

  // Audit Trail
  created_at         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updated_at         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  created_by         String?            @map("created_by") @db.Uuid
  updated_by         String?            @map("updated_by") @db.Uuid

  order              Order              @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user               User               @relation("UserCertificates", fields: [user_id], references: [id], onDelete: Cascade)
  motorbike          CustomerMotorbike? @relation(fields: [motorbike_id], references: [id], onDelete: SetNull)
  creator            User?              @relation("CertificateCreator", fields: [created_by], references: [id], onDelete: SetNull)
  updater            User?              @relation("CertificateUpdater", fields: [updated_by], references: [id], onDelete: SetNull)
  revoker            User?              @relation("CertificateRevoker", fields: [revoked_by], references: [id], onDelete: SetNull)

  @@index([serial_number, is_active, is_revoked])
  @@index([serial_number, verification_token])
  @@index([user_id])
  @@map("t_trx_exhaust_certificates")
  @@schema("transaction")
}

